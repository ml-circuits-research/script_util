#!/usr/bin/env bash
# tmux_remote — pornește bridge-ul Sesori într-o sesiune tmux
#
# `tmux_remote`        pornește `sesori-bridge run` într-o sesiune tmux
#                      (dacă rulează deja, doar se atașează la ea)
# `tmux_remote stop`   oprește bridge-ul (închide sesiunea tmux)
#
# După ce iese bridge-ul, sesiunea rămâne deschisă cu un shell
# (vezi mesajele lui cu cifre/eroări în panou).
#
# Link ca să ai comanda în PATH:
#   ln -sf /home/salboaie/work/script_util/bin/tmux_remote ~/.local/bin/tmux_remote

SESSION="sesori-bridge"
BRIDGE_BIN="${SESORI_BRIDGE_BIN:-sesori-bridge}"

case "${1:-}" in
  -h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac
command -v tmux >/dev/null 2>&1 || { echo "Eroare: tmux nu e instalat" >&2; exit 1; }
command -v "$BRIDGE_BIN" >/dev/null 2>&1 || { echo "Eroare: '$BRIDGE_BIN' nu e în PATH" >&2; exit 1; }

attach() {
  if [ -n "${TMUX:-}" ]; then tmux switch-client -t "=$1"; else tmux attach-session -t "=$1"; fi
}

case "${1:-}" in
  stop)
    if tmux kill-session -t "=$SESSION" 2>/dev/null; then echo "Bridge oprit."
    else echo "Bridge-ul nu rulează."; fi
    ;;
  *)
    if ! tmux has-session -t "=$SESSION" 2>/dev/null; then
      # $SHELL rămâne după ieșirea bridge-ului, ca la celelalte tool-uri
      tmux new-session -d -s "$SESSION" "$BRIDGE_BIN run; exec \${SHELL:-bash}"
      tmux set-option -t "$SESSION" @agent sesori 2>/dev/null
    fi
    attach "$SESSION"
    ;;
esac
