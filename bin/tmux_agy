#!/usr/bin/env bash
# tmux_agy — meniu mic pentru sesiuni Antigravity CLI (agy) în tmux
#
# Rulezi `tmux_agy` și alegi cu săgețile:
#   + Sesiune nouă aici    pornește agy în folderul curent, într-o sesiune tmux
#   Sesiuni agy            sesiunile tale agy din tmux (cu folderul și conversația lor)
#   Oprite                 sesiuni care rulau înainte (ex. înainte de restart PC):
#                          - dacă știe conversația, o repornește direct
#                          - altfel îți arată conversațiile din folderul ei (pasul 2)
#   Conversații            conversațiile agy din folderul curent -> le reia în tmux
#
# Implicit pornește agy cu --dangerously-skip-permissions (fără întrebări de confirmare).
# Poți schimba/goli flag-urile prin AGY_FLAGS (ex: AGY_FLAGS="" tmux_agy).
#
# Taste: ↑/↓ (sau j/k) navighezi · Enter alegi · x închizi/ștergi · q ieși/înapoi
#
# Istoricul e în ~/.agy-tmux-sessions: nume tmux, folder, id conversație, data.
# Doar sesiunile agy ajung în istoric; celelalte sesiuni tmux nu sunt ale noastre.

REG="${AGY_TMUX_SESSIONS_FILE:-$HOME/.agy-tmux-sessions}"
AGY_BIN="${AGY_BIN:-agy}"
AGY_DATA_DIR="${AGY_DATA_DIR:-$HOME/.gemini/antigravity-cli}"
AGY_FLAGS="${AGY_FLAGS---dangerously-skip-permissions}"
MAX_CONV="${AGY_TMUX_MAX_CONV:-10}"

# diacriticele au nevoie de UTF-8 ca să se taie corect rândurile
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in *[Uu][Tt][Ff]*) ;; *) export LC_CTYPE=C.UTF-8 ;; esac

die() { echo "Eroare: $*" >&2; exit 1; }
case "${1:-}" in
  -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac
command -v tmux >/dev/null 2>&1 || die "tmux nu e instalat"
command -v "$AGY_BIN" >/dev/null 2>&1 || die "'$AGY_BIN' nu e în PATH"
command -v python3 >/dev/null 2>&1 || die "python3 nu e instalat"
[[ "$MAX_CONV" =~ ^[1-9][0-9]*$ ]] || die "AGY_TMUX_MAX_CONV trebuie să fie un număr pozitiv"
touch "$REG" || die "Nu pot scrie istoricul '$REG'"
CATALOG=$(mktemp) || die "Nu pot crea catalogul temporar"
trap 'rm -f "$CATALOG"; tput cnorm 2>/dev/null || true' EXIT

# ---------------- utilitare ----------------

running() { tmux has-session -t "=$1" 2>/dev/null </dev/null; }
short()   { echo "${1/#$HOME/~}"; }
safe()    { local n="$1"; echo "${n//[.: ]/_}"; }          # tmux nu acceptă . : în nume
# Marcajul explicit are prioritate față de nume și istoricul vechi.
mark_ours() { tmux set-option -t "=$1:" @agent agy 2>/dev/null </dev/null; }
legacy_ours() {
  local sid owner
  IFS=$'\t' read -r _ _ sid _ owner <<< "$(reg_get "$1")"
  [ -n "$owner" ] && { [ "$owner" = agy ]; return; }
  case "$1" in
    agy-*) return 0 ;;
    cc-*|claude-*|codex-*|omp-*|agy-*|vibe-*) return 1 ;;
  esac
  [ -n "$sid" ] && [ "$sid" != - ]
}
session_ours() {
  local owner pid line t1 t2
  owner=$(tmux show-option -v -t "=$1:" @agent 2>/dev/null </dev/null)
  [ -n "$owner" ] && { [ "$owner" = agy ]; return; }
  if legacy_ours "$1"; then mark_ours "$1"; return 0; fi
  pid=$(tmux display-message -p -t "=$1:" '#{pane_pid}' 2>/dev/null </dev/null)
  [ -n "$pid" ] || return 1
  # Identifică executabilul agentului, inclusiv când este pornit prin node/bash.
  # Nu consideră procesele node/python ca agenți fără numele executabilului.
  while IFS= read -r line; do
    read -r t1 t2 _ <<< "$line"
    case "$t1" in
      "$AGY_BIN"|*/"${AGY_BIN##*/}"|antigravity-cli|*/antigravity-cli) mark_ours "$1"; return 0 ;;
      sh|*/sh|bash|*/bash|dash|*/dash|node|*/node|bun|*/bun|env|*/env|python*)
        case "$t2" in
          "$AGY_BIN"|*/"${AGY_BIN##*/}"|antigravity-cli|*/antigravity-cli) mark_ours "$1"; return 0 ;;
        esac ;;
    esac
  done < <(ps -o args= -p "$pid" 2>/dev/null; ps -o args= --ppid "$pid" 2>/dev/null)
  return 1
}

# Leagă gruparea de folderul de pornire al sesiunii, nu de cd-ul din panou.
same_directory() {
  local left right
  left=$(cd -- "$1" 2>/dev/null && pwd -P) || left="$1"
  right=$(pwd -P)
  [ "$left" = "$right" ]
}

group_sessions() {
  local i scope kind head label
  local old_L=("${L[@]}") old_A=("${A[@]}") old_N=("${N[@]}") old_D=("${D[@]}") old_S=("${S[@]}") old_T=("${T[@]}")
  reset_items
  item "${old_L[0]}" "${old_A[0]}" "${old_N[0]}" "${old_D[0]}" "${old_S[0]}"
  for scope in local global; do
    for kind in tmux stopped; do
      head=
      for ((i=1; i<${#old_A[@]}; i++)); do
        [ "${old_A[i]}" = "$kind" ] || continue
        if same_directory "${old_D[i]}"; then
          [ "$scope" = local ] || continue
        else
          [ "$scope" = global ] || continue
        fi
        if [ -z "$head" ]; then
          if [ "$scope" = local ]; then label="Directorul curent"; else label="Globale (alte directoare)"; fi
          if [ "$kind" = tmux ]; then label+=" — active"; else label+=" — oprite (Enter = repornește)"; fi
          item "$label" head; head=1
        fi
        item "${old_L[i]}" "$kind" "${old_N[i]}" "${old_D[i]}" "${old_S[i]}" "${old_T[i]}"
      done
    done
  done
}

# Catalogul conversațiilor agy: citim history.jsonl și transcripturile din brain/<id>/
# pentru a afla id-ul, folderul (workspace), primul mesaj / titlul și timestamp-ul.
load_catalog() {
  python3 - "$AGY_DATA_DIR" "$CATALOG" <<'EOF'
import json, re, sys
from pathlib import Path
from datetime import datetime

root, target = Path(sys.argv[1]), Path(sys.argv[2])
rows = {}

def parse_ts(val, fallback):
    if isinstance(val, (int, float)):
        return float(val) / 1000.0 if val > 1e11 else float(val)
    if isinstance(val, str) and val.strip():
        s = val.strip()
        if s.isdigit():
            v = float(s)
            return v / 1000.0 if v > 1e11 else v
        try:
            return datetime.fromisoformat(s.replace('Z', '+00:00')).timestamp()
        except ValueError:
            pass
    return fallback

def clean_user_text(text):
    if not isinstance(text, str):
        return ''
    m = re.search(r'<USER_REQUEST>\s*(.*?)\s*</USER_REQUEST>', text, re.S)
    if m:
        text = m.group(1)
    for line in text.splitlines():
        line = line.strip()
        if line and not line.startswith('<'):
            return line[:70]
    return ''

hist = root / 'history.jsonl'
if hist.is_file():
    try:
        mtime = hist.stat().st_mtime
        with hist.open(errors='replace') as stream:
            for line in stream:
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(d, dict):
                    continue
                cid = d.get('conversationId') or d.get('id') or d.get('sessionId')
                cwd = d.get('workspace') or d.get('cwd') or d.get('projectDir')
                if isinstance(cwd, list):
                    cwd = cwd[0] if cwd else None
                if not cid:
                    continue
                title = clean_user_text(d.get('display') or d.get('title') or d.get('prompt') or '')
                ts = parse_ts(d.get('timestamp') or d.get('updatedAt') or d.get('createdAt'), mtime)
                prev = rows.get(cid)
                if not prev or ts >= prev['updated']:
                    rows[cid] = dict(
                        id=cid,
                        cwd=cwd or (prev['cwd'] if prev else ''),
                        title=title or (prev['title'] if prev else ''),
                        updated=ts,
                    )
    except OSError:
        pass

brain = root / 'brain'
if brain.is_dir():
    for tfile in brain.glob('*/.system_generated/logs/transcript.jsonl'):
        try:
            cid = tfile.parent.parent.parent.name
            mtime = tfile.stat().st_mtime
            if cid in rows and rows[cid].get('title') and rows[cid].get('cwd'):
                if mtime > rows[cid]['updated']:
                    rows[cid]['updated'] = mtime
                continue
            title = rows.get(cid, {}).get('title', '')
            cwd = rows.get(cid, {}).get('cwd', '')
            with tfile.open(errors='replace') as stream:
                for line in stream:
                    try:
                        event = json.loads(line)
                    except ValueError:
                        continue
                    if not title and event.get('type') == 'USER_INPUT':
                        title = clean_user_text(event.get('content') or '')
                    if not cwd:
                        c = event.get('content') or ''
                        if isinstance(c, str):
                            m = re.search(r'Command Working Directory:\s*(\S+)', c)
                            if m:
                                cwd = m.group(1)
                    if not cwd:
                        for tc in event.get('tool_calls') or []:
                            args = (tc.get('args') or {}) if isinstance(tc, dict) else {}
                            for k in ('Path', 'Cwd', 'Directory'):
                                v = args.get(k)
                                if isinstance(v, str):
                                    v = v.strip('"')
                                    if v.startswith('/') and not v.startswith(str(root)):
                                        p = Path(v)
                                        for parent in ([p] if p.is_dir() else []) + list(p.parents):
                                            if (parent / '.git').exists():
                                                cwd = str(parent)
                                                break
                                        if not cwd and p.parent.is_dir():
                                            cwd = str(p.parent)
                                        if cwd:
                                            break
                            if cwd:
                                break
                    if title and cwd:
                        break
            rows[cid] = dict(
                id=cid,
                cwd=cwd,
                title=title,
                updated=max(mtime, rows.get(cid, {}).get('updated', 0)),
            )
        except OSError:
            continue

with target.open('w') as stream:
    json.dump(sorted(rows.values(), key=lambda r: r['updated'], reverse=True), stream)
EOF
}

preview() {  # titlul conversației
  python3 - "$CATALOG" "$1" <<'EOF'
import json, sys
for row in json.load(open(sys.argv[1])):
    if row['id'] == sys.argv[2]:
        print(' '.join(row['title'].split())[:70])
        break
EOF
}

attach() {
  if [ -n "${TMUX:-}" ]; then tmux switch-client -t "=$1"; else tmux attach-session -t "=$1"; fi
}

# Un panou rămas la shell nu înseamnă că agentul mai rulează.
agent_stopped() {
  local command dead
  dead=$(tmux display-message -p -t "=$1:" '#{pane_dead}' 2>/dev/null </dev/null)
  [ "$dead" = 1 ] && return 0
  command=$(tmux display-message -p -t "=$1:" '#{pane_current_command}' 2>/dev/null </dev/null)
  case "${command##*/}" in bash|sh|dash|zsh|fish|ksh) return 0 ;; esac
  return 1
}

launch() {  # nume folder id new|resume
  local name="$1" dir="$2" sid="$3" mode="$4" cmd
  [ -d "$dir" ] || { echo "Folderul '$dir' nu mai există." >&2; return 1; }
  printf -v cmd '%q' "$AGY_BIN"
  if [ -n "$AGY_FLAGS" ]; then
    cmd+=" $AGY_FLAGS"
  fi
  if [ "$mode" != new ]; then
    if [ -n "$sid" ]; then
      local quoted_sid
      printf -v quoted_sid '%q' "$sid"
      cmd+=" --resume $quoted_sid"
    else
      cmd+=" --continue"
    fi
  fi
  # După ce iese agy, sesiunea rămâne deschisă cu un shell.
  # Forțăm bash pentru ca escaping-ul %q să fie interpretat corect.
  local runner
  printf -v runner '%q -lc %q' "${BASH}" "$cmd; exec \${SHELL:-bash}"
  if running "$name"; then
    session_ours "$name" && agent_stopped "$name" || return 1
    tmux new-window -t "=$name:" -c "$dir" "$runner" || return 1
  else
    tmux new-session -d -s "$name" -c "$dir" "$runner" || return 1
  fi
  mark_ours "$name"                                # sesiunea ne aparține de acum
}

# Timpul de activitate este cel raportat de tmux (inclusiv output în panou).
relative_time() {
  local stamp="$1" now="${TIME_NOW:-$(date +%s)}" elapsed count unit
  [[ "$stamp" =~ ^[0-9]+$ ]] && [ "$stamp" -gt 0 ] || { printf 'unknown'; return; }
  elapsed=$((now - stamp))
  if [ "$elapsed" -lt 60 ]; then printf 'just now'; return; fi
  if [ "$elapsed" -lt 3600 ]; then count=$((elapsed / 60)); unit=minute
  elif [ "$elapsed" -lt 86400 ]; then count=$((elapsed / 3600)); unit=hour
  elif [ "$elapsed" -lt 604800 ]; then count=$((elapsed / 86400)); unit=day
  elif [ "$elapsed" -lt 2592000 ]; then count=$((elapsed / 604800)); unit=week
  elif [ "$elapsed" -lt 31536000 ]; then count=$((elapsed / 2592000)); unit=month
  else count=$((elapsed / 31536000)); unit=year
  fi
  [ "$count" -eq 1 ] || unit+=s
  printf '%s %s ago' "$count" "$unit"
}

session_times() {
  local created activity
  IFS=$'\t' read -r created activity < <(awk -F'\t' -v n="$1" '$1 == n {print $6 "\t" $7; exit}' "$REG")
  printf 'started %s · active %s' "$(relative_time "$created")" "$(relative_time "$activity")"
}

# ---------------- istoricul ----------------

reg_get() { awk -F'\t' -v n="$1" '$1 == n {print; exit}' "$REG"; }
reg_del() {
  local tmp; tmp=$(mktemp)
  awk -F'\t' -v n="$1" '$1 != n && $1 != ""' "$REG" > "$tmp" && mv "$tmp" "$REG"
}
reg_set() {  # nume folder id — adaugă sau înlocuiește
  local created activity
  created=$(tmux display-message -p -t "=$1:" '#{session_created}' 2>/dev/null </dev/null)
  activity=$(tmux display-message -p -t "=$1:" '#{session_activity}' 2>/dev/null </dev/null)
  reg_del "$1"
  # "-" = conversație necunoscută (un câmp gol s-ar pierde la citire)
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "${3:--}" "$(date '+%Y-%m-%d %H:%M')" agy "${created:--}" "${activity:--}" >> "$REG"
}
reg_touch() {  # actualizează timpii, păstrând conversația salvată
  local sid
  sid=$(awk -F'\t' -v n="$1" '$1 == n {print $3; exit}' "$REG")
  reg_set "$1" "$2" "$sid"
}

# ---------------- acțiuni ----------------

new_session() {  # folder
  local def name sid
  def=$(safe "agy-$(basename "$1")-$(date +%H%M%S)")
  read -rp "Nume sesiune [$def]: " name
  name=$(safe "${name:-$def}")
  if ! running "$name"; then
    sid=""
    launch "$name" "$1" "$sid" new || return 1
    reg_set "$name" "$1" "$sid"
  fi
  session_ours "$name" || { echo "Sesiunea '$name' aparține altui tool." >&2; return 1; }
  attach "$name"
}

open_conv() {  # nume folder id — pornește conversația în sesiunea dată și atașează
  if ! running "$1" || agent_stopped "$1"; then
    launch "$1" "$2" "$3" resume || return 1
    reg_set "$1" "$2" "$3"
  fi
  session_ours "$1" || { echo "Sesiunea '$1' aparține altui tool." >&2; return 1; }
  attach "$1"
}

# ---------------- elementele meniului ----------------
# L = text, A = tip, N = nume sesiune, D = folder, S = id conversație
# tipuri: new | tmux | stopped | conv | subnew | subconv | head

item() { L+=("$1"); A+=("$2"); N+=("$3"); D+=("$4"); S+=("$5"); T+=("${6:-}"); }
reset_items() { L=(); A=(); N=(); D=(); S=(); T=(); }

add_convs() {  # folder tip nume-sesiune ascunde-cele-din-istoric(1/0) titlu
  local dir="$1" kind="$2" name="$3" hide="$4" title="$5" id lbl stamp k=0 head=
  while IFS=$'\t' read -r id stamp lbl; do
    [ "$hide" = 1 ] && awk -F'\t' -v id="$id" '$3 == id {found=1} END {exit !found}' "$REG" && continue
    [ -z "$head" ] && [ -n "$title" ] && { item "$title" head; head=1; }
    item "$stamp   ${lbl:-(fără text)}" "$kind" "$name" "$dir" "$id"
    k=$((k + 1)); [ "$k" -ge "$MAX_CONV" ] && break
  done < <(python3 - "$CATALOG" "$dir" <<'EOF'
import json, os, sys
from datetime import datetime
target_dir = os.path.realpath(sys.argv[2])
for row in json.load(open(sys.argv[1])):
    cwd = row.get('cwd') or ''
    if cwd and os.path.realpath(cwd) != target_dir:
        continue
    stamp = datetime.fromtimestamp(row['updated']).strftime('%d.%m %H:%M')
    label = ' '.join(row['title'].split())[:70] or '(fără text)'
    print(f"{row['id']}\t{stamp}\t{label}")
EOF
  )
}

build_main() {
  load_catalog || die "Nu pot citi istoricul agy"
  reset_items
  local n d s _ path cmd att lbl rec head
  TIME_NOW=$(date +%s)
  TITLE="agy  $(short "$PWD")"

  item "+ Sesiune nouă aici" new "" "$PWD"

  head=
  while IFS= read -r n; do
    [ -z "$n" ] && continue
    session_ours "$n" || continue
    [ -z "$head" ] && { item "Sesiuni agy" head; head=1; }
    path=$(tmux display-message -p -t "=$n:" '#{session_path}' 2>/dev/null </dev/null)
    cmd=$(tmux display-message -p -t "=$n:" '#{pane_current_command}' 2>/dev/null </dev/null)
    att=$(tmux display-message -p -t "=$n:" '#{session_attached}' 2>/dev/null </dev/null)
    reg_touch "$n" "$path"                         # sesiune agy pornită manual: o adoptăm
    IFS=$'\t' read -r _ d s _ <<< "$(reg_get "$n")"; [ "$s" = - ] && s=
    lbl="$n   $(short "$path")"
    if [ -n "$s" ]; then lbl+="   · $(preview "$s")"
    elif [[ "$cmd" == agy* || "$cmd" == node* || "$cmd" == bun* || "$cmd" == antigravity* ]]; then lbl+="   · agy"
    fi
    [ "${att:-0}" -gt 0 ] && lbl+="   ●"
    if agent_stopped "$n"; then
      item "$lbl" stopped "$n" "$path" "$s" "$(session_times "$n")"
    else
      item "$lbl" tmux "$n" "$path" "$s" "$(session_times "$n")"
    fi
  done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)

  head=
  while IFS=$'\t' read -r n d s _; do
    { [ -z "$n" ] || running "$n"; } && continue
    legacy_ours "$n" || continue
    [ "$s" = - ] && s=
    [ -z "$head" ] && { item "Oprite (Enter = repornește)" head; head=1; }
    lbl="$n   $(short "$d")"
    if [ -n "$s" ]; then rec=$(preview "$s"); lbl+="   · ${rec:-conversație salvată}"
    else lbl+="   · alegi conversația →"
    fi
    item "$lbl" stopped "$n" "$d" "$s" "$(session_times "$n")"
  done < "$REG"

  group_sessions
  add_convs "$PWD" conv "" 1 "Conversații în acest folder"
}

build_sub() {  # nume folder — pasul 2: ce pornesc în sesiunea oprită
  reset_items
  TITLE="$1  $(short "$2")  — alege conversația"
  item "+ Continuă ultima conversație din folder (--continue)" subcontinue "$1" "$2"
  item "+ Conversație nouă" subnew "$1" "$2"
  add_convs "$2" subconv "$1" 0 "Conversații în folder"
}

# ---------------- meniul cu săgeți ----------------

DRAWN=0
if [ "${BASH_VERSINFO[0]}" -ge 4 ]; then ESC_T=0.05; else ESC_T=1; fi

erase() { [ "$DRAWN" -gt 0 ] && printf '\e[%dA\e[J' "$DRAWN"; DRAWN=0; }
out()   { printf '\r\e[K%s\n' "$1"; DRAWN=$((DRAWN + 1)); }

draw() {
  local cols i t w
  cols=$(tput cols 2>/dev/null || echo 80); w=$((cols - 5))
  erase
  out "$(printf '\e[1m%s\e[0m' "${TITLE:0:$w}")"
  for ((i = 0; i < ${#L[@]}; i++)); do
    t=${L[$i]}; t=${t:0:$w}
    if [ "${A[$i]}" = head ]; then
      out ""; out "$(printf '  \e[2m%s\e[0m' "$t")"
    elif [ "$i" -eq "$CUR" ]; then
      out "$(printf '\e[36;1m ❯ %s\e[0m' "$t")"
    else
      out "   $t"
    fi
    if [ -n "${T[$i]}" ]; then
      out "$(printf '   \e[2m%s\e[0m' "${T[$i]:0:$w}")"
    fi
  done
  out ""
  out "$(printf '\e[2m↑↓ navighează · Enter alege · x închide/șterge · q ieșire/înapoi\e[0m')"
}

step() {  # mută cursorul, sărind peste titluri
  local i=$CUR
  while :; do
    i=$((i + $1))
    { [ "$i" -lt 0 ] || [ "$i" -ge "${#L[@]}" ]; } && return
    [ "${A[$i]}" != head ] && { CUR=$i; return; }
  done
}

menu() {  # setează CUR și KEY_ACT (enter|x); întoarce 1 la q/Esc
  local key rest
  [ "$CUR" -ge "${#L[@]}" ] && CUR=0
  tput civis 2>/dev/null
  while :; do
    draw
    IFS= read -rsn1 key || { erase; tput cnorm 2>/dev/null; return 1; }
    if [ "$key" = $'\e' ]; then read -rsn2 -t "$ESC_T" rest; key+="$rest"; fi
    case "$key" in
      $'\e[A'|$'\eOA'|k) step -1 ;;
      $'\e[B'|$'\eOB'|j) step 1 ;;
      '')                KEY_ACT=enter; break ;;
      x|X)               KEY_ACT=x; break ;;
      q|Q|$'\e')         erase; tput cnorm 2>/dev/null; return 1 ;;
    esac
  done
  erase; tput cnorm 2>/dev/null
  return 0
}

# pasul 2 pentru o sesiune oprită fără conversație cunoscută
sub_menu() {  # nume folder
  local sid
  CUR=0
  build_sub "$1" "$2"
  while menu; do
    [ "$KEY_ACT" = enter ] || continue
    case "${A[$CUR]}" in
      subcontinue) sid=""; launch "$1" "$2" "$sid" resume || return 1
                   reg_set "$1" "$2" "$sid"; attach "$1" && exit ;;
      subnew)      sid=""; launch "$1" "$2" "$sid" new || return 1
                   reg_set "$1" "$2" "$sid"; attach "$1" && exit ;;
      subconv)     open_conv "$1" "$2" "${S[$CUR]}" && exit ;;
    esac
  done
  return 1   # înapoi la meniul principal
}

main() {
  local ok
  CUR=0
  while :; do
    build_main
    menu || exit 0
    local i=$CUR

    if [ "$KEY_ACT" = x ]; then
      case "${A[$i]}" in
        tmux)
          read -rp "Închid sesiunea tmux '${N[$i]}'? [d/N] " ok
          case "$ok" in d|D|y|Y) tmux kill-session -t "=${N[$i]}"; reg_del "${N[$i]}" ;; esac ;;
        stopped)
          reg_del "${N[$i]}" ;;   # conversația rămâne în folderul ei
      esac
      continue
    fi

    case "${A[$i]}" in
      new)     new_session "$PWD" && exit ;;
      tmux)    attach "${N[$i]}" && exit ;;
      conv)    open_conv "$(safe "agy-$(basename "$PWD")-${S[$i]:0:8}")" "$PWD" "${S[$i]}" && exit ;;
      stopped)
        if [ -n "${S[$i]}" ]; then open_conv "${N[$i]}" "${D[$i]}" "${S[$i]}" && exit; continue; fi
        sub_menu "${N[$i]}" "${D[$i]}"
        CUR=0 ;;
    esac
  done
}

main

